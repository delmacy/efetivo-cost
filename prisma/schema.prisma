generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum MonthStatus {
  OPEN
  LOCKED
}

enum UnavailabilityStatus {
  APPROVED
  PENDING
  REJECTED
}

enum AssignmentOrigin {
  BASE
  RECALCULATED
  MANUAL
  SWAP
}

model Technician {
  id                Int                  @id @default(autoincrement())
  name              String
  participatesScale Boolean              @default(true)
  active            Boolean              @default(true)
  referenceDate     DateTime
  dailyHours        Int                  @default(8)
  assignments       Assignment[]
  unavailabilities  Unavailability[]
  workAdjustments   WorkAdjustment[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model MonthControl {
  id         Int         @id @default(autoincrement())
  year       Int
  month      Int
  status     MonthStatus @default(OPEN)
  cutoffDate DateTime
  version    Int         @default(1)
  updatedAt  DateTime    @updatedAt

  @@unique([year, month])
}

model Assignment {
  id           Int              @id @default(autoincrement())
  date         DateTime
  hours        Int              @default(24)
  technicianId Int
  technician   Technician       @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  origin       AssignmentOrigin @default(BASE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([date])
  @@index([technicianId, date])
}

model Unavailability {
  id                Int                  @id @default(autoincrement())
  technicianId      Int
  technician        Technician           @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  startDate         DateTime
  endDate           DateTime
  reason            String
  affectsScale      Boolean              @default(true)
  affectsOffice     Boolean              @default(true)
  status            UnavailabilityStatus @default(APPROVED)
  reviewNote        String?
  createdAt         DateTime             @default(now())
  reviewedAt        DateTime?

  @@index([technicianId, startDate, endDate])
}

model WorkAdjustment {
  id           Int        @id @default(autoincrement())
  technicianId Int
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  date         DateTime
  type         String
  hours        Int
  reason       String
  createdAt    DateTime   @default(now())

  @@index([technicianId, date])
}